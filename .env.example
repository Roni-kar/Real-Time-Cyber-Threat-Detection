# Copy this file to .env (which is intentionally gitignored) or set values in
# the operating-system environment before starting a component.

# Shared runtime configuration
CTD_LOG_LEVEL=INFO
THREAT_API_URL=http://127.0.0.1:8000

# FastAPI service
CTD_MODEL_PATH=ai_model/artifacts/intrusion_detection_model.joblib
CTD_DATABASE_PATH=backend_api/data/traffic.db
CTD_MAX_LOG_RECORDS=1000
CTD_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
CTD_ENABLE_DOCS=true

# Packet capture
CYBER_SNIFFER_INTERFACE=
CYBER_SNIFFER_BPF_FILTER=ip
CYBER_PACKET_LIMIT=0
CYBER_API_URL=http://127.0.0.1:8000/api/v1/packets/analyze
CYBER_API_TIMEOUT_SECONDS=2.5
CYBER_FLOW_IDLE_SECONDS=120
CYBER_MAX_TRACKED_FLOWS=10000
CYBER_VERIFY_TLS=true

# Streamlit dashboard
DASHBOARD_REQUEST_TIMEOUT=3

# Reproducible training defaults
# These defaults are passed on the command line to `python -m ai_model.model`.
# Keep an optional KDDTest+ file outside version control if you add it.
